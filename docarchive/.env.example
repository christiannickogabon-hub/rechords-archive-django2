DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave DB_NAME unset to keep using sqlite3. Set these once a PostgreSQL
# server is available to switch the app over.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Brevo (https://brevo.com) delivers the one-time sign-in codes for super administrators.
# The sender address must be a verified sender in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Municipality of Carigara Document Archive
